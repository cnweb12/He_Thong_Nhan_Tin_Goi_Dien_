{
  "name": "chat-app-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx watch src/server.js",
    "db:sync-indexes": "node database/mongo/sync-indexes.js",
    "db:seed": "node scripts/database/seed-dev-data.js",
    "db:reset": "node scripts/database/reset-local-database.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-memory-tests.js",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:coverage": "c8 node --test tests/**/*.test.js",
    "test:auth": "node --test tests/modules/auth/*.test.js",
    "test:conversations": "node --test tests/modules/conversations/*.test.js",
    "test:devices": "node --test tests/modules/devices/*.test.js",
    "test:users": "node --test tests/modules/users/*.test.js",
    "test:messages": "node --test tests/modules/messages/*.test.js",
    "test:calls": "node --test tests/modules/calls/*.test.js"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "mongoose": "^8.12.1",
    "multer": "^2.1.1",
    "ngrok": "^5.0.0-beta.2",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.6.0",
    "c8": "^11.0.0",
    "mongodb-memory-server": "^11.1.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
